    <script>
        // ============ SPA NAVIGATION ============
        function goTo(pageName) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            const target = document.getElementById('page-' + pageName);
            if (target) target.classList.add('active');

            // Nav links active state
