<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CTI Risk Intelligence System | AI-Powered Threat Analysis</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --primary: #00d4ff;
            --secondary: #7b2fff;
            --danger: #ff3366;
            --warning: #ffaa00;
            --success: #00ff88;
            --dark: #050a18;
            --dark2: #0a1628;
            --dark3: #0f2040;
            --glass: rgba(0, 212, 255, 0.05);
            --glass-border: rgba(0, 212, 255, 0.15);
            --text: #c8d8e8;
            --text-bright: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: var(--dark);
            color: var(--text);
            overflow-x: hidden;
            min-height: 100vh;
        }

        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background-image:
                linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 20s linear infinite;
        }

        @keyframes gridMove {
            0% {
                transform: translateY(0);
            }

            100% {
                transform: translateY(50px);
            }
        }

        .bg-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(123, 47, 255, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(0, 212, 255, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 100%, rgba(255, 51, 102, 0.05) 0%, transparent 50%);
        }

        /* ============ TICKER ============ */
        .threat-ticker {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(5, 10, 24, 0.95);
            border-bottom: 1px solid var(--danger);
            padding: 6px 0;
            overflow: hidden;
        }

        .ticker-inner {
            display: flex;
            align-items: center;
            gap: 0;
        }

        .ticker-label {
            background: var(--danger);
            color: white;
            padding: 2px 15px;
            font-family: 'Orbitron', monospace;
            font-size: 0.65rem;
            font-weight: 700;
            white-space: nowrap;
            letter-spacing: 2px;
            flex-shrink: 0;
        }

        .ticker-scroll {
            overflow: hidden;
            flex: 1;
        }

        .ticker-content {
            display: flex;
            animation: tickerScroll 40s linear infinite;
            white-space: nowrap;
        }

        .ticker-item {
            padding: 0 40px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.72rem;
            color: var(--warning);
        }

        .ticker-item span {
            color: var(--danger);
            margin-right: 8px;
        }

        @keyframes tickerScroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        /* ============ NAVBAR ============ */
        nav {
            position: fixed;
            top: 32px;
            left: 0;
            right: 0;
            z-index: 999;
            background: rgba(5, 10, 24, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 15px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }

        .nav-logo-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
            animation: logoPulse 3s ease-in-out infinite;
        }

        @keyframes logoPulse {

            0%,
            100% {
                box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
            }

            50% {
                box-shadow: 0 0 40px rgba(0, 212, 255, 0.6), 0 0 60px rgba(123, 47, 255, 0.3);
            }
        }

        .nav-brand {
            font-family: 'Orbitron', monospace;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
            text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .nav-brand span {
            color: var(--secondary);
        }

        .nav-links {
            display: flex;
            gap: 5px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            transition: all 0.3s;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary);
            border-color: var(--glass-border);
            background: var(--glass);
            text-shadow: 0 0 10px var(--primary);
        }

        .nav-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            color: var(--success);
            font-family: 'Share Tech Mono', monospace;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--success);
            border-radius: 50%;
            animation: blink 1.5s ease-in-out infinite;
            box-shadow: 0 0 8px var(--success);
        }

        @keyframes blink {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.3;
            }
        }

        /* ============ STEP NAV ============ */
        .step-nav {
            max-width: 900px;
            margin: 30px auto 0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 0 20px;
        }

        .step-nav a.step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.68rem;
            position: relative;
            flex: 1;
            text-align: center;
            cursor: pointer;
        }

        .step-nav a.step .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--dark2);
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            font-size: 0.8rem;
            color: var(--text);
            transition: all 0.3s;
            z-index: 2;
        }

        .step-nav a.step.active .step-circle {
            border-color: var(--primary);
            color: var(--primary);
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
            background: rgba(0, 212, 255, 0.1);
        }

        .step-nav a.step.active {
            color: var(--primary);
        }

        .step-nav a.step:hover .step-circle {
            border-color: var(--primary);
        }

        .step-nav a.step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 18px;
            left: calc(50% + 22px);
            width: calc(100% - 44px);
            height: 1px;
            background: var(--glass-border);
            z-index: 1;
        }

        /* ============ MAIN ============ */
        main {
            position: relative;
            z-index: 1;
            padding-top: 100px;
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
            animation: pageIn 0.5s ease;
        }

        @keyframes pageIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============ HERO ============ */
        .hero {
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px;
            position: relative;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid var(--glass-border);
            padding: 6px 18px;
            border-radius: 50px;
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: var(--primary);
            margin-bottom: 30px;
            animation: fadeInDown 0.8s ease;
        }

        .hero-title {
            font-family: 'Orbitron', monospace;
            font-size: clamp(2rem, 6vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
            animation: fadeInUp 0.8s ease 0.2s both;
        }

        .hero-title .line1 {
            color: var(--text-bright);
            display: block;
        }

        .hero-title .line2 {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: block;
            text-shadow: none;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: var(--text);
            max-width: 700px;
            line-height: 1.7;
            margin-bottom: 40px;
            animation: fadeInUp 0.8s ease 0.4s both;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 0.8s ease 0.6s both;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 14px 35px;
            border-radius: 8px;
            font-family: 'Orbitron', monospace;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 40px rgba(0, 212, 255, 0.5);
        }

        .btn-secondary {
            background: transparent;
            color: var(--primary);
            border: 1px solid var(--glass-border);
            padding: 14px 35px;
            border-radius: 8px;
            font-family: 'Orbitron', monospace;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-secondary:hover {
            background: var(--glass);
            border-color: var(--primary);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.2);
        }

        .hero-orb {
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 212, 255, 0.1) 0%, transparent 70%);
            animation: orbPulse 4s ease-in-out infinite;
            pointer-events: none;
            z-index: -1;
        }

        @keyframes orbPulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.2);
                opacity: 1;
            }
        }

        .hero-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(0, 212, 255, 0.1);
            animation: ringExpand 4s ease-in-out infinite;
        }

        .hero-ring:nth-child(2) {
            width: 300px;
            height: 300px;
            animation-delay: 0s;
        }

        .hero-ring:nth-child(3) {
            width: 500px;
            height: 500px;
            animation-delay: 1s;
        }

        .hero-ring:nth-child(4) {
            width: 700px;
            height: 700px;
            animation-delay: 2s;
        }

        @keyframes ringExpand {
            0% {
                transform: scale(0.9);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.1;
            }

            100% {
                transform: scale(0.9);
                opacity: 0.5;
            }
        }

        .hero-stats {
            display: flex;
            gap: 40px;
            margin-top: 60px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 0.8s ease 0.8s both;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-family: 'Orbitron', monospace;
            font-size: 2rem;
            font-weight: 900;
            color: var(--primary);
            text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text);
            letter-spacing: 2px;
            margin-top: 5px;
        }

        /* ============ SECTIONS ============ */
        section {
            padding: 100px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-tag {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
            color: var(--primary);
            letter-spacing: 4px;
            margin-bottom: 15px;
            display: block;
        }

        .section-title {
            font-family: 'Orbitron', monospace;
            font-size: clamp(1.5rem, 3vw, 2.5rem);
            font-weight: 700;
            color: var(--text-bright);
            margin-bottom: 15px;
        }

        .section-title span {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-desc {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.7;
        }

        /* ============ GLASS CARD ============ */
        .glass-card {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            backdrop-filter: blur(10px);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .glass-card:hover::before {
            opacity: 1;
        }

        .glass-card:hover {
            border-color: rgba(0, 212, 255, 0.3);
            transform: translateY(-5px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 30px rgba(0, 212, 255, 0.05);
        }

        /* ============ QUICK LINK CARDS ============ */
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
        }

        .quick-card {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            display: block;
        }

        .quick-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            opacity: 0;
            transition: opacity 0.3s;
        }

        .quick-card:hover::before {
            opacity: 1;
        }

        .quick-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0, 212, 255, 0.3);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .quick-card-num {
            font-family: 'Orbitron', monospace;
            font-size: 0.7rem;
            color: var(--primary);
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .quick-card-icon {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .quick-card-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-bright);
            margin-bottom: 10px;
        }

        .quick-card-desc {
            font-size: 0.82rem;
            color: var(--text);
            line-height: 1.6;
        }

        /* ============ ANALYZER ============ */
        .analyzer-section {
            background: linear-gradient(180deg, transparent 0%, rgba(0, 212, 255, 0.02) 50%, transparent 100%);
        }

        .analyzer-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            align-items: start;
        }

        .analyzer-input-panel {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
        }

        .panel-header {
            background: rgba(0, 212, 255, 0.05);
            border-bottom: 1px solid var(--glass-border);
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .panel-dots {
            display: flex;
            gap: 6px;
        }

        .panel-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .panel-dot:nth-child(1) {
            background: var(--danger);
        }

        .panel-dot:nth-child(2) {
            background: var(--warning);
        }

        .panel-dot:nth-child(3) {
            background: var(--success);
        }

        .panel-body {
            padding: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            color: var(--primary);
            margin-bottom: 8px;
            letter-spacing: 1px;
            font-family: 'Share Tech Mono', monospace;
        }

        .form-select {
            width: 100%;
            background: var(--dark3);
            border: 1px solid var(--glass-border);
            color: var(--text);
            padding: 12px 15px;
            border-radius: 8px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.95rem;
            cursor: pointer;
            outline: none;
            transition: border-color 0.3s;
            -webkit-appearance: none;
        }

        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.1);
        }

        .form-textarea {
            width: 100%;
            background: var(--dark3);
            border: 1px solid var(--glass-border);
            color: var(--text);
            padding: 15px;
            border-radius: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            resize: vertical;
            min-height: 180px;
            outline: none;
            transition: border-color 0.3s;
            line-height: 1.6;
        }

        .form-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.1);
        }

        .analyze-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 15px;
            border-radius: 8px;
            font-family: 'Orbitron', monospace;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .analyze-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.4);
        }

        .analyze-btn:active {
            transform: translateY(0);
        }

        .result-panel {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
            min-height: 500px;
        }

        .result-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 400px;
            gap: 20px;
            color: rgba(200, 216, 232, 0.3);
        }

        .result-placeholder i {
            font-size: 4rem;
            color: rgba(0, 212, 255, 0.2);
        }

        .result-content {
            padding: 25px;
            display: none;
        }

        .risk-display {
            text-align: center;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 25px;
            position: relative;
            overflow: hidden;
        }

        .risk-display.high {
            background: rgba(255, 51, 102, 0.1);
            border: 1px solid rgba(255, 51, 102, 0.3);
        }

        .risk-display.medium {
            background: rgba(255, 170, 0, 0.1);
            border: 1px solid rgba(255, 170, 0, 0.3);
        }

        .risk-display.low {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid rgba(0, 255, 136, 0.3);
        }

        .risk-level-text {
            font-family: 'Orbitron', monospace;
            font-size: 3rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .risk-display.high .risk-level-text {
            color: var(--danger);
            text-shadow: 0 0 30px var(--danger);
        }

        .risk-display.medium .risk-level-text {
            color: var(--warning);
            text-shadow: 0 0 30px var(--warning);
        }

        .risk-display.low .risk-level-text {
            color: var(--success);
            text-shadow: 0 0 30px var(--success);
        }

        .risk-label {
            font-size: 0.9rem;
            letter-spacing: 3px;
            color: var(--text);
        }

        .confidence-section {
            margin-bottom: 25px;
        }

        .confidence-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.85rem;
        }

        .confidence-bar {
            height: 8px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
            overflow: hidden;
        }

        .confidence-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 1.5s ease;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
        }

        .ioc-section {
            margin-bottom: 25px;
        }

        .ioc-title {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: var(--primary);
            margin-bottom: 12px;
            font-family: 'Share Tech Mono', monospace;
        }

        .ioc-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .ioc-tag {
            background: rgba(0, 212, 255, 0.08);
            border: 1px solid rgba(0, 212, 255, 0.2);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 4px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
        }

        .ioc-tag.danger {
            background: rgba(255, 51, 102, 0.08);
            border-color: rgba(255, 51, 102, 0.2);
            color: var(--danger);
        }

        .category-bars {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .cat-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .cat-name {
            font-size: 0.8rem;
            font-family: 'Share Tech Mono', monospace;
            color: var(--text);
            width: 120px;
            flex-shrink: 0;
        }

        .cat-bar {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 3px;
            overflow: hidden;
        }

        .cat-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 1.5s ease;
        }

        .cat-pct {
            font-size: 0.8rem;
            font-family: 'Share Tech Mono', monospace;
            color: var(--text);
            width: 40px;
            text-align: right;
        }

        /* ============ DASHBOARD ============ */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric-card {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 25px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }

        .metric-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 212, 255, 0.3);
        }

        .metric-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
        }

        .metric-card.blue::after {
            background: linear-gradient(90deg, var(--primary), transparent);
        }

        .metric-card.purple::after {
            background: linear-gradient(90deg, var(--secondary), transparent);
        }

        .metric-card.red::after {
            background: linear-gradient(90deg, var(--danger), transparent);
        }

        .metric-card.green::after {
            background: linear-gradient(90deg, var(--success), transparent);
        }

        .metric-icon {
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .metric-card.blue .metric-icon {
            color: var(--primary);
        }

        .metric-card.purple .metric-icon {
            color: var(--secondary);
        }

        .metric-card.red .metric-icon {
            color: var(--danger);
        }

        .metric-card.green .metric-icon {
            color: var(--success);
        }

        .metric-value {
            font-family: 'Orbitron', monospace;
            font-size: 2rem;
            font-weight: 900;
            color: var(--text-bright);
            margin-bottom: 5px;
        }

        .metric-label {
            font-size: 0.8rem;
            color: var(--text);
            letter-spacing: 1px;
        }

        .metric-change {
            font-size: 0.75rem;
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .metric-change.up {
            color: var(--danger);
        }

        .metric-change.down {
            color: var(--success);
        }

        .threat-feed {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
        }

        .feed-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            transition: background 0.2s;
            animation: feedSlideIn 0.5s ease;
        }

        @keyframes feedSlideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .feed-item:hover {
            background: rgba(0, 212, 255, 0.03);
        }

        .feed-severity {
            width: 60px;
            height: 24px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 1px;
            flex-shrink: 0;
            font-family: 'Orbitron', monospace;
        }

        .feed-severity.high {
            background: rgba(255, 51, 102, 0.2);
            color: var(--danger);
            border: 1px solid rgba(255, 51, 102, 0.3);
        }

        .feed-severity.medium {
            background: rgba(255, 170, 0, 0.2);
            color: var(--warning);
            border: 1px solid rgba(255, 170, 0, 0.3);
        }

        .feed-severity.low {
            background: rgba(0, 255, 136, 0.2);
            color: var(--success);
            border: 1px solid rgba(0, 255, 136, 0.3);
        }

        .feed-info {
            flex: 1;
        }

        .feed-title {
            font-size: 0.9rem;
            color: var(--text-bright);
            margin-bottom: 3px;
            font-weight: 500;
        }

        .feed-meta {
            font-size: 0.75rem;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            display: flex;
            gap: 15px;
        }

        .feed-time {
            font-size: 0.75rem;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            flex-shrink: 0;
        }

        .chart-panel {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
        }

        .mini-chart {
            padding: 20px;
            height: 250px;
            position: relative;
        }

        .chart-bars {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            height: 100%;
            padding-bottom: 25px;
        }

        .chart-bar-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            height: 100%;
            justify-content: flex-end;
        }

        .chart-bar {
            width: 100%;
            border-radius: 4px 4px 0 0;
            transition: height 1s ease;
            cursor: pointer;
        }

        .chart-bar.high-bar {
            background: linear-gradient(180deg, var(--danger), rgba(255, 51, 102, 0.3));
        }

        .chart-bar.medium-bar {
            background: linear-gradient(180deg, var(--warning), rgba(255, 170, 0, 0.3));
        }

        .chart-bar.low-bar {
            background: linear-gradient(180deg, var(--success), rgba(0, 255, 136, 0.3));
        }

        .chart-label {
            font-size: 0.65rem;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            white-space: nowrap;
        }

        /* ============ IOC SCANNER ============ */
        .ioc-scanner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .scanner-input {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
        }

        .ioc-input-field {
            width: 100%;
            background: var(--dark3);
            border: 1px solid var(--glass-border);
            color: var(--text-bright);
            padding: 12px 15px;
            border-radius: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .ioc-input-field:focus {
            border-color: var(--primary);
        }

        /* ============ ARCHITECTURE ============ */
        .arch-flow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            flex-wrap: wrap;
            margin-top: 60px;
        }

        .arch-node {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 25px 20px;
            text-align: center;
            width: 160px;
            position: relative;
            transition: all 0.3s;
            cursor: default;
        }

        .arch-node:hover {
            border-color: var(--primary);
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.15);
        }

        .arch-node-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .arch-node-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--text-bright);
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .arch-node-desc {
            font-size: 0.72rem;
            color: var(--text);
            line-height: 1.5;
        }

        .arch-arrow {
            width: 40px;
            height: 2px;
            background: linear-gradient(90deg, var(--glass-border), var(--primary), var(--glass-border));
            position: relative;
            flex-shrink: 0;
        }

        .arch-arrow::after {
            content: '▶';
            position: absolute;
            right: -8px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary);
            font-size: 0.8rem;
        }

        .arch-arrow::before {
            content: '';
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--primary);
            border-radius: 50%;
            top: 50%;
            transform: translateY(-50%);
            animation: flowDot 2s linear infinite;
            box-shadow: 0 0 8px var(--primary);
        }

        @keyframes flowDot {
            0% {
                left: 0;
                opacity: 1;
            }

            100% {
                left: calc(100% - 8px);
                opacity: 0.3;
            }
        }

        /* ============ FEATURES ============ */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .feature-card {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .feature-card.blue::before {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .feature-card.red::before {
            background: linear-gradient(90deg, var(--danger), var(--secondary));
        }

        .feature-card.green::before {
            background: linear-gradient(90deg, var(--success), var(--primary));
        }

        .feature-card.purple::before {
            background: linear-gradient(90deg, var(--secondary), var(--primary));
        }

        .feature-card.orange::before {
            background: linear-gradient(90deg, var(--warning), var(--danger));
        }

        .feature-card.teal::before {
            background: linear-gradient(90deg, #00e5ff, var(--success));
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-card:hover {
            border-color: rgba(0, 212, 255, 0.2);
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
        }

        .feature-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 20px;
        }

        .feature-card.blue .feature-icon {
            background: rgba(0, 212, 255, 0.1);
            color: var(--primary);
        }

        .feature-card.red .feature-icon {
            background: rgba(255, 51, 102, 0.1);
            color: var(--danger);
        }

        .feature-card.green .feature-icon {
            background: rgba(0, 255, 136, 0.1);
            color: var(--success);
        }

        .feature-card.purple .feature-icon {
            background: rgba(123, 47, 255, 0.1);
            color: var(--secondary);
        }

        .feature-card.orange .feature-icon {
            background: rgba(255, 170, 0, 0.1);
            color: var(--warning);
        }

        .feature-card.teal .feature-icon {
            background: rgba(0, 229, 255, 0.1);
            color: #00e5ff;
        }

        .feature-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-bright);
            margin-bottom: 12px;
        }

        .feature-desc {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* ============ MODAL ============ */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(5, 10, 24, 0.95);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(10px);
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            animation: modalIn 0.4s ease;
        }

        @keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(0.8);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .modal-title {
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            color: var(--text-bright);
            margin-bottom: 15px;
        }

        .modal-desc {
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 25px;
        }

        /* ============ FOOTER ============ */
        footer {
            border-top: 1px solid var(--glass-border);
            padding: 60px 40px 30px;
            position: relative;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 60px;
            max-width: 1400px;
            margin: 0 auto 40px;
        }

        .footer-brand {
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .footer-desc {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        .footer-title {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: var(--primary);
            font-family: 'Share Tech Mono', monospace;
            margin-bottom: 20px;
        }

        .footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .footer-links a {
            color: var(--text);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s;
            cursor: pointer;
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        .footer-bottom {
            border-top: 1px solid var(--glass-border);
            padding-top: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
            font-size: 0.8rem;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
        }

        /* ============ ANIMATIONS ============ */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(0, 212, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ============ GLITCH ============ */
        .glitch {
            position: relative;
        }

        .glitch::before,
        .glitch::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
        }

        .glitch::before {
            animation: glitch1 3s infinite;
            color: var(--primary);
            clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
        }

        .glitch::after {
            animation: glitch2 3s infinite;
            color: var(--secondary);
            clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
        }

        @keyframes glitch1 {

            0%,
            90%,
            100% {
                transform: translate(0);
            }

            92% {
                transform: translate(-2px, 1px);
            }

            94% {
                transform: translate(2px, -1px);
            }

            96% {
                transform: translate(-1px, 2px);
            }
        }

        @keyframes glitch2 {

            0%,
            90%,
            100% {
                transform: translate(0);
            }

            92% {
                transform: translate(2px, -1px);
            }

            94% {
                transform: translate(-2px, 1px);
            }

            96% {
                transform: translate(1px, -2px);
            }
        }

        /* ============ TOOLTIP ============ */
        [data-tooltip] {
            position: relative;
        }

        [data-tooltip]:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--dark3);
            border: 1px solid var(--glass-border);
            color: var(--text);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            white-space: nowrap;
            font-family: 'Share Tech Mono', monospace;
            z-index: 100;
        }

        .sample-threats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .sample-btn {
            background: rgba(0, 212, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Share Tech Mono', monospace;
        }

        .sample-btn:hover {
            background: rgba(0, 212, 255, 0.1);
            border-color: var(--primary);
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 1024px) {

            .analyzer-container,
            .ioc-scanner {
                grid-template-columns: 1fr;
            }

            .dashboard-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .step-nav a.step span.step-label {
                display: none;
            }
        }

        @media (max-width: 768px) {
            nav {
                padding: 15px 20px;
            }

            .nav-links {
                display: none;
            }

            section {
                padding: 60px 20px;
            }

            .dashboard-grid {
                grid-template-columns: 1fr 1fr;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .quick-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .arch-flow {
                flex-direction: column;
            }

            .arch-arrow {
                transform: rotate(90deg);
            }
        }
    </style>
</head>

